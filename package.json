{
  "name": "game_basquete",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/checklist.mjs && node tests/e2e/attack.mjs",
    "apk": "npm run build && npx cap sync android && cd android && JAVA_HOME=${JAVA_HOME:-$HOME/jdk/jdk-21.0.12.1+1/Contents/Home} ./gradlew assembleDebug -q && cp app/build/outputs/apk/debug/app-debug.apk ../StreetBasketballFight.apk"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10"
  }
}
